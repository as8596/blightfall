; Engine configuration file.
; Blightfall — M1 combat prototype.
; See docs/BUILD-PLAN.md. Every setting below is required by Week 1 / Day 1.

config_version=5

[application]

config/name="Blightfall"
config/description="Top-down action RPG. M1 combat prototype."
run/main_scene="res://levels/prototype/prototype_room.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoloads/events.gd"
Rng="*res://autoloads/rng.gd"
HitStop="*res://autoloads/hit_stop.gd"
Sfx="*res://autoloads/sfx.gd"
DebugSettings="*res://autoloads/debug_settings.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

