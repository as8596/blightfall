[gd_resource type="Theme" load_steps=2 format=3]

; The interface theme, and it exists for one reason: to stop Godot inventing a
; bold and an italic that the fonts do not have.
;
; `dico`, `alagard` and `cavalhatriz` ship a single weight each. Asked for bold,
; Godot *emboldens* — it smears each glyph sideways by a fraction of a pixel.
; Asked for italic, it *skews* — it shears the glyph off the pixel grid. Both are
; reasonable approximations for a vector typeface and both are illegible on a
; pixel font: the strokes stop being whole pixels, which is the one thing the
; whole font depends on.
;
; So bold, italic and bold-italic are all pointed at the same face as normal.
; `[b]` and `[i]` still parse, they just render as text. Emphasis is carried by
; colour instead — see `ui/game_menu.gd`.

[ext_resource type="Font" path="res://art/fonts/ui_font.tres" id="1_font"]

[resource]
default_font = ExtResource("1_font")
default_font_size = 16
RichTextLabel/fonts/bold_font = ExtResource("1_font")
RichTextLabel/fonts/bold_italics_font = ExtResource("1_font")
RichTextLabel/fonts/italics_font = ExtResource("1_font")
RichTextLabel/fonts/mono_font = ExtResource("1_font")
RichTextLabel/fonts/normal_font = ExtResource("1_font")
