[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://resources/quests/quest_step.gd" id="2_step"]
[ext_resource type="Resource" path="res://resources/items/defs/salve.tres" id="3_salve"]

[sub_resource type="Resource" id="Step_timber"]
script = ExtResource("2_step")
