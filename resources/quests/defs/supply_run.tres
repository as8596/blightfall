[resource]
script = ExtResource("1_quest")
id = &"supply_run"
title = "The south road"
giver = &"shopkeeper"
summary = "The carters stopped coming up from the valley in the spring. Maren buys what you bring instead, and pays over the odds for it. Not charity, she says. She has nobody else to buy from."
steps = Array[Resource]([SubResource("Step_timber"), SubResource("Step_stone")])
gold = 60
experience = 25
items = Array[Resource]([ExtResource("3_salve")])
repeatable = true
